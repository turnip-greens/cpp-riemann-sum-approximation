# ==========================================
# CLion and JetBrains
.idea/
cmake-build-*/

# Visual Studio Code
.vscode/
.cache/

# Visual Studio (MSVC)
.vs/

# QtCreator
CMakeLists.txt.user*

# ==========================================
# User Presets (Keep your local configs private)
# ==========================================
CMakeUserPresets.json
